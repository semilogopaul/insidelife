# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcards in production).
CORS_ORIGINS=http://localhost:3100,http://localhost:8080
# Origins of the separate admin portal (insidelife-admin repo), comma-separated. https only on the live site,
# e.g. https://admin.insidelife.online. Empty = no browser can use the admin API. Admin requests that change something
# must carry one of these as their Origin (in production, a request without an Origin is refused).
ADMIN_ORIGINS=http://localhost:5174
# Optional: serve the admin API only on this host, e.g. admin-api.insidelife.online (docs/DEPLOY.md). Empty = off.
ADMIN_API_HOST=
LOG_LEVEL=debug

# --- Database (PostgreSQL 17) ---
DATABASE_URL=postgres://insidelife:insidelife@localhost:55432/insidelife
DATABASE_POOL_SIZE=20
# Run pending migrations on boot (recommended for local/docker).
DATABASE_RUN_MIGRATIONS=true

# --- Redis 7 ---
REDIS_URL=redis://localhost:56379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
# Sessions roll: every refresh (each ~15 min of play) pushes the expiry out again, so only this many days of
# inactivity signs a player out.
REFRESH_TOKEN_TTL_DAYS=30
# Set true when served over HTTPS.
COOKIE_SECURE=false
# true = players must enter a 6-digit email code before creating a character and playing.
# false (default) = optional: players can verify from Me -> Settings -> Account.
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (verification codes) ---
# Leave empty locally: the code is printed in this server's log and shown on the code screen (development only).
# Production needs it when REQUIRE_EMAIL_VERIFICATION=true. One URL (smtp://... port 587 STARTTLS, smtps://... 465),
# with the user/password URL-encoded (@ -> %40), e.g. smtp://hello%40insidelife.online:app-password@smtp.example.com:587
SMTP_URL=
# ...or the separate fields instead of SMTP_URL:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Inside Life <hello@insidelife.online>

# --- Game world ---
# Real wall-clock time at which the game clock reads 1 Jan 2027 06:00 (ISO-8601).
GAME_EPOCH=2026-10-01T00:00:00.000Z
# Game minutes per real minute (120 = 1 real second is 2 game minutes).
GAME_TIME_SCALE=120
WORLD_SEED=eko-o-ni-baje
# Secret seed for stock/crypto prices (keep private so nobody can compute tomorrow's close).
MARKET_SEED=local-market-seed-change-me-0123456789

# --- Flutterwave v3 (dashboard → Settings → API keys, and Settings → Webhooks) ---
# Leave the secret key empty locally to use the built-in sandbox checkout (never available in production).
# Test keys look like FLWSECK_TEST-…-X / FLWPUBK_TEST-…-X; the live site needs the live keys (FLWSECK-…).
# The encryption key is only for direct card charges; we use hosted checkout, so it is not needed.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "Secret hash" you type in Settings → Webhooks; Flutterwave sends it back in the verif-hash header.
# Generate one with: openssl rand -hex 32   (paste the same value into the dashboard)
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Where Flutterwave sends players back after checkout (defaults to this in development). Players are sent back to the
# origin they're actually using instead when it's in CORS_ORIGINS: testing on a phone through a tunnel (VS Code
# port forwarding, ngrok…)? Add its https origin to CORS_ORIGINS, e.g. https://abc123-3100.uks1.devtunnels.ms
PAYMENT_CALLBACK_URL=http://localhost:3100/payments/callback
# Real naira one account may spend on top-ups per UTC day. 0 = no cap (players buy as much as they want).
TOPUP_DAILY_LIMIT_NGN=0
# Largest single top-up in real naira (packs or a custom amount; the minimum is ₦500).
TOPUP_MAX_PER_PAYMENT_NGN=10000000
ALLOW_PAYMENT_SANDBOX=false

# --- Object storage (SeaweedFS in docker-compose; any S3-compatible store in production) ---
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_ACCESS_KEY=insidelife
S3_SECRET_KEY=insidelife-storage-secret
S3_BUCKET=insidelife-media
# Private bucket for chat voice notes and photos (never readable anonymously; the API streams them).
S3_PRIVATE_BUCKET=insidelife-private
S3_PUBLIC_BASE_URL=/media
# Comma-separated owner emails: full access to the admin portal (and they can grant the admin role to others).
ADMIN_EMAILS=oluwasemilogo@insidelife.online
# Encrypts admins' authenticator-app secrets at rest (32+ random characters). Required on the live site and must never
# change afterwards (admins would have to set up their authenticator again). Locally it falls back to the JWT secret.
# ADMIN_MFA_KEY=
# Admin portal sessions: access token lifetime, and when the session ends (idle / absolute).
ADMIN_ACCESS_TTL_SECONDS=600
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_SESSION_MAX_HOURS=12
# Days a deleted account can still be restored by support before it is anonymised.
ACCOUNT_RESTORE_DAYS=30
# Sponsored apps sold on every player's phone home screen (0-20).
PHONE_APP_AD_SLOTS=10
