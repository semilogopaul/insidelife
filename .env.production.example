# Secrets for docker-compose.prod.yml. Copy to .env.production (never commit it) and fill every value.
# Generate random values with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Database and Redis passwords (private network only, but still random).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Signs player sessions. 48+ random characters. Changing it signs everyone out.
JWT_ACCESS_SECRET=
# Private seed for stock/crypto prices (nobody must be able to compute tomorrow's close).
MARKET_SEED=

# Paystack live secret key (Dashboard → Settings → API Keys & Webhooks). Webhook URL:
#   https://insidelife.online/api/v1/payments/paystack/webhook
PAYSTACK_SECRET_KEY=sk_live_
TOPUP_DAILY_LIMIT_NGN=20000

# Object storage keys (any random strings; the API and SeaweedFS both use them).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email verification codes. REQUIRE_EMAIL_VERIFICATION=true makes players confirm their email before playing (and
# then SMTP_URL is required); false lets them verify later from Me -> Settings. See docs/DEPLOY.md -> Email.
#   SMTP_URL=smtp://USER:PASSWORD@smtp-relay.brevo.com:587   (URL-encode @ in the user as %40)
REQUIRE_EMAIL_VERIFICATION=false
SMTP_URL=
MAIL_FROM=Inside Life <hello@insidelife.online>

# Owners of the admin portal (full access; can grant the admin role to others). Not shown to players.
ADMIN_EMAILS=oluwasemilogo@insidelife.online
# Where the separate admin portal is served (see docs/DEPLOY.md -> Admin portal). https only.
ADMIN_ORIGINS=https://admin.insidelife.online
# Optional: serve the admin API only on this host (docs/DEPLOY.md -> "A separate host for the admin API"). Empty = off.
ADMIN_API_HOST=
# Encrypts admins' authenticator secrets. 32+ random characters; never change it once set.
ADMIN_MFA_KEY=
# Let's Encrypt expiry notices.
ACME_EMAIL=oluwasemilogo@insidelife.online

# When the game clock started (keep it fixed once players exist) and the world seed.
GAME_EPOCH=2026-11-01T00:00:00.000Z
GAME_TIME_SCALE=120
WORLD_SEED=eko-o-ni-baje
PHONE_APP_AD_SLOTS=10
