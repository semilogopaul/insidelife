# Where Next proxies /api in development (and in Docker for server-side calls).
BACKEND_INTERNAL_URL=http://localhost:4000
# Realtime socket origin. Empty = same origin (Docker/nginx). In local dev, point at the API directly.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Canonical origin for absolute OpenGraph/Twitter image URLs (default https://insidelife.online).
# NEXT_PUBLIC_SITE_URL=https://staging.insidelife.online
# Service worker: on by default in production builds; `off` disables it, `on` enables it under `next dev`.
# NEXT_PUBLIC_SERVICE_WORKER=on
